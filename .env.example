# ===== 必填 =====
# 机器人服务的对象（你自己的 QQ 号）
OWNER_QQ=

# 大模型 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# OneBot WebSocket 地址（与 NapCat 里配置的端口一致）
ONEBOT_WS=ws://127.0.0.1:3001
# NapCat 如果设置了 token，填在这里
ONEBOT_TOKEN=

# ===== 角色 =====
# 角色设定，直接决定说话风格
PERSONA=你是一个说话简洁、有点毒舌但可靠的私人助理。回答控制在三句话以内，不要使用 Markdown 语法。

# ===== 对话节奏 =====
# 保留多少轮对话作为短期记忆
HISTORY_TURNS=12
# 收到消息后回复的概率（0-1）
REPLY_CHANCE=0.9
# 连发消息合并窗口（秒）
REPLY_DEBOUNCE_SECONDS=6
# 是否把回复拆成多条发送，更像真人
SPLIT_REPLY=1

# ===== 主动消息 =====
# 主动问候时间，留空则关闭
MORNING_TIME=08:00
NIGHT_TIME=22:30
# 静默多少小时后开始主动搭话
IDLE_HOURS=4
# 两次主动消息的最小间隔（小时）
IDLE_MIN_GAP_HOURS=4
# 说晚安后多久不打扰（小时）
QUIET_HOURS=8

# ===== 情绪与关系 =====
MOOD_ENABLED=1
MOOD_START_HOURS=6
RELATIONSHIP_START_POINTS=40
# 暧昧满好感时，她主动搭话里有多少概率是在问关系
HER_CONFESS_CHANCE=0.12

# ===== 她的设定（留空则跳过）=====
SCHOOL_NAME=
MAJOR=

# ===== 生活作息 =====
LIFE_ENABLED=1
LIFE_TICK_MINUTES=30
LIFE_EVENT_CHANCE=0.18
# 晚安时间按精力在窗口内浮动
NIGHT_DYNAMIC=1
NIGHT_EARLIEST=22:20
NIGHT_LATEST=00:40
# 她偶尔会离开一会儿再回来
AWAY_ENABLED=1
AWAY_CHANCE=0.06

# ===== 稳定性 =====
# 连不上 OneBot 多久后弹桌面通知
DISCONNECT_ALERT_MINUTES=10

# ===== 联网工具 =====
WEB_ENABLED=1
# 本机代理，留空则直连
WEB_PROXY=

# ===== 图片理解（可选）=====
# 指向一个包含 vision_api_key / vision_api_base / vision_model 的 JSON 文件
VISION_CONFIG=

# ===== 语音（可选）=====
VOICE_ENABLED=0
TTS_VOICE=zh-CN-XiaoyiNeural
